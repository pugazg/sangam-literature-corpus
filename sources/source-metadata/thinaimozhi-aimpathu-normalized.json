      "source_note_lines": [],
      "status": "source-transcribed",
      "division_sequence": 1,
      "division_as_printed": "1.  குறிஞ்சி"
    },
    {
      "poem_number": 6,
      "poem_number_as_printed": 6,
      "source_order": 6,
      "lines": [
        "யானை உழலும் மணிகிளர் நீள்வரைக்",
