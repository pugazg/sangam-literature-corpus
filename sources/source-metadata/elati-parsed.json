      "poem_number": 77,
      "poem_number_as_printed": 77,
      "source_order": 77,
      "lines": [
        "நாற்கதியும் துன்ப நவைதீர்த்தல் வேண்டுவான்",
        "பாற்கதியின் பாற்பட ஆராய்ந்து நூற்கதியின்",
        "எல்லை உயர்த்தார் தவமுயலின் மூன்(று) ஐந்(து) ஏழ்",
        "வல்லைளீ(டு) ஆகும் வகு."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
