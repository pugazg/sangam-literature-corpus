    {
      "poem_number": 78,
      "poem_number_as_printed": 78,
      "source_order": 78,
      "lines": [
        "தாயிழந்த பிள்ளை தலையிழந்த பெண்டாட்டி",
        "வாயிழந்த வாழ்வினார் வாணிகம் - போயிழந்தார்",
        "கைத்தூண் பொருளிழந்தார் கண்ணிலவர்க்(கு) ஈந்தார்",
        "வைத்து வழங்கிவாழ் வார்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "division_sequence": null,
      "division_as_printed": null
