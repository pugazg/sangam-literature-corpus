    {
      "poem_number": 79,
      "poem_number_as_printed": 79,
      "source_order": 79,
      "lines": [
        "சாக்காடு கேடு பகைதுன்பம் இன்பமே",
        "நாக்காடு நாட்டறை போக்குமென - நாக்காட்ட",
        "நட்டார்க்(கு) இயையின் தமக்கியைந்த கூ(று) உடம்",
        "பட்டார்வாய்ப் பட்டது பண்பு."
      ],
      "source_note_lines": [],
