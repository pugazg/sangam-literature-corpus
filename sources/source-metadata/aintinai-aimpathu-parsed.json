      "poem_number_as_printed": 3,
      "source_order": 3,
      "lines": [
        "மின்னும் முழக்கும் இடியும்மற் றின்ன",
        "கொலைப்படை சாலப் பரப்பிய முல்லை",
        "முகைவென்ற பல்லினாய்! இல்லையோ? மற்று",
        "நமர்சென்ற நாட்டுள்இக் கார்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "முல்லை",
