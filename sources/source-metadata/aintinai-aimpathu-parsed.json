    {
      "poem_number": 5,
      "poem_number_as_printed": 5,
      "source_order": 5,
      "lines": [
        "கோடுயர் தோற்றம் மலைமேல் இருங்கொண்மூக்",
        "கூடி நிரந்து தலைபிணங்கி - ஓடி",
        "வளிகலந்து வந்துறைக்கும் வானம்காண் தோறும்",
        "துளிகலந்து வீழ்தருங் கண்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "முல்லை",
      "thinai_as_printed": "முல்லை",
