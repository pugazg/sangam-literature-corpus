      "poem_number_as_printed": 2,
      "source_order": 2,
      "lines": [
        "அணிநிற மஞ்ஞை அகவ இரங்கி",
        "மணிநிற மாமலைமேல் தாழ்ந்து - பணிமொழி !",
        "கார்நீர்மை கொண்ட கலிவானம் காண்தொறும்",
        "பீர்நீர்மை கொண்டன தோள்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "முல்லை",
