    {
      "poem_number": 23,
      "poem_number_as_printed": 23,
      "source_order": 23,
      "lines": [
        "யாணர் அகல்வயல் ஊரன் அருளுதல்",
        "பாண! பரிந்துரைக்க வேண்டுமோ - மாண",
        "அறிவ(து) அறியும் அறிவினார் கேண்மை",
        "நெறியே உரையாதோ மற்று."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
