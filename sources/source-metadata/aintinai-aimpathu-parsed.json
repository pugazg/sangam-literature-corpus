    {
      "poem_number": 24,
      "poem_number_as_printed": 24,
      "source_order": 24,
      "lines": [
        "கோலச் சறுகுருகின் குத்(து)அஞ்சி ஈர்வாளை",
        "நீலத்துப் புக்கொளிக்கும் ஊரற்கு - மேல்எலாம்",
        "சார்தற்குச் சந்தனச்சாந்(து) ஆயினேம் இப்பருவம்",
        "காரத்தின் வெய்யஎம் தோள்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
      "division_sequence": 3,
      "position_within_division": 4
    },
    {
      "poem_number": 25,
      "poem_number_as_printed": 25,
      "source_order": 25,
      "lines": [
        "அழல்அவிழ் தாமரை ஆய்வய லூரன்",
        "விழைதரு மார்பம் உறுநோய் - விழையின்",
        "குழலும் குடுமிஎன் பாலகன் கூறும்",
        "மழலைவாய் கட்டுரை யால்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
      "division_sequence": 3,
      "position_within_division": 5
    },
    {
      "poem_number": 26,
      "poem_number_as_printed": 26,
      "source_order": 26,
      "lines": [
        "பெய்வளைக் கையாய்! பெருநகை ஆகின்ற",
        "செய்வய லூரன் வதுவை விழ(வு)இயம்பக்",
        "கைபுனை தேரேறிச் செல்வானைச் சென்றிவன்",
        "எய்தி இடருற்ற வாறு."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
      "division_sequence": 3,
      "position_within_division": 6
    },
    {
      "poem_number": 27,
      "poem_number_as_printed": 27,
      "source_order": 27,
      "lines": [
        "தணவயல் ஊரன் புலக்கும் தகையமோ",
        "நுண்ணுறல் போல நுணங்கிய ஐங்கூந்தல்",
        "வெண்மரல் போல நிறந்திரிந்து வேறாய",
        "வண்ணம் உடையேம்மற்(று) யாம்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
      "division_sequence": 3,
      "position_within_division": 7
    },
    {
      "poem_number": 28,
      "poem_number_as_printed": 28,
      "source_order": 28,
      "lines": [
        "ஒல்லென்(று) ஒலிக்கும் ஒலிபுனல் ஊரற்கு",
        "வல்லென்(று) என்நெஞ்சம் வாட்கண்ணாய் - நில்லென்னா(து)",
        "ஏக்கற்றாங்(கு) என்மகன் தான்நிற்ப என்னானும்",
        "நோக்கான்தேர் ஊர்ந்து கண்டு."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
      "division_sequence": 3,
      "position_within_division": 8
    },
    {
      "poem_number": 29,
      "poem_number_as_printed": 29,
      "source_order": 29,
      "lines": [
        "ஒல்லென் ஒலிபுனல் ஊரன் வியன்மார்பம்",
        "புல்லேன்யான் என்பேன் புனையிழையாய்! - புல்லேன்",
        "எனக்கோர் குறிப்பும் உடையனோ ஊரன்",
        "தனக்(கு)ஏவல் செய்தொழுகு வேன்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
      "division_sequence": 3,
      "position_within_division": 9
    },
    {
      "poem_number": 30,
      "poem_number_as_printed": 30,
      "source_order": 30,
      "lines": [
        "குளிரும் பருவத்தே யாயினும் தென்றல்",
        "வளியெறியின் மெய்யிற்(கு) இனிதாம் - ஒளியிழாய் !",
        "ஊடி யிருப்பினும் ஊரன் நறுமேனி",
        "கூடல் இனிதாம் எனக்கு."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "மருதம்",
      "thinai_as_printed": "3.  மருதம்",
      "division_sequence": 3,
      "position_within_division": 10
    },
    {
      "poem_number": 31,
      "poem_number_as_printed": 31,
      "source_order": 31,
      "lines": [
        "உதிரம் துவரிய வேங்கை உகிர்போல்",
        "எதிரி முருக்கரும்ப வீர்ந்தண்கார் நீங்க - எதிருநர்க்(கு)",
        "இன்பம் பயந்த இளவேனில் காண்தொறும்",
        "துன்பம் கலந்தழியும் நெஞ்சு."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 1
    },
    {
      "poem_number": 32,
      "poem_number_as_printed": 32,
      "source_order": 32,
      "lines": [
        "விலங்கல் விளங்கிழாய்! செல்லாரோ வல்லர்",
        "அழற்பட்(டு) அசைந்த பிடியை - எழிற்களிறு",
        "கற்சுனைச் சேற்றிடைச் சின்னீரைக் கையாற்கொண்(டு)",
        "உச்சி ஒழுக்கஞ் சுரம்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 2
    },
    {
      "poem_number": 33,
      "poem_number_as_printed": 33,
      "source_order": 33,
      "lines": [
        "பாவையும் பந்தும் பவளவாய்ப் பைங்கிளியும்",
        "ஆயமும் ஒன்றும் இவைநினையாள் - பால்போலும்",
        "ஆய்ந்த மொழியினாள் செல்லுங்கொல் காதலன்பின்",
        "காய்ந்து கதிர்தெறூஉங் காடு."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 3
    },
    {
      "poem_number": 34,
      "poem_number_as_printed": 34,
      "source_order": 34,
      "lines": [
        "கோட்டமை வல்லில் கொலைபிரியா வன்கண்ணர்",
        "ஆட்டிவிட்(டு) ஆறலைக்கும் அத்தம் பலநீந்தி",
        "வேட்ட முனைவயின் சேறீரோ ஐய! நீர்",
        "வாள்தடங்கண் மாதரை நீத்து."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 4
    },
    {
      "poem_number": 35,
      "poem_number_as_printed": 35,
      "source_order": 35,
      "lines": [
        "கொடுவில் எயினர்தம் கொல்படையால் வீழ்ந்த",
        "தடிநிணம் மாந்திய பேஎய் - நடுகல்",
        "விரிநிழல் கண்படுக்கும் வெங்கானம் என்பர்",
        "பொருள்புரிந்தார் போய சுரம்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 5
    },
    {
      "poem_number": 36,
      "poem_number_as_printed": 36,
      "source_order": 36,
      "lines": [
        "கடி(து)ஓடும் வெண்தேரை நீராம்என்(று) எண்ணிப்",
        "பிடியோ(டு) ஒருங்கோடித் தாள்பிணங்கி வீழும்",
        "வெடியோடும் வெங்கானம் சேர்வார்கொல் நல்லாய்",
        "தொடியோடி வீழத் துறந்து."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 6
    },
    {
      "poem_number": 37,
      "poem_number_as_printed": 37,
      "source_order": 37,
      "lines": [
        "தோழியர் சூழத் துறைமுன்றில் ஆடுங்கால்",
        "வீழ்பவள் போலத் தளருங்கால் - தாழாது",
        "கல்லதர் அத்தத்தைக் காதலன் பின்போதல்",
        "வல்லவோ மாதர் நடை."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 7
    },
    {
      "poem_number": 38,
      "poem_number_as_printed": 38,
      "source_order": 38,
      "lines": [
        "சுனைவாய்ச் சிறுநீரை எய்தாதென் றெண்ணிப்",
        "பிணைமான் இனிதுண்ண வேண்டிக் - கலைமாத்தன்",
        "கள்ளத்தின் ஊச்சும் சுரமென்பர் காதலர்",
        "உள்ளம் படர்ந்த நெறி."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
