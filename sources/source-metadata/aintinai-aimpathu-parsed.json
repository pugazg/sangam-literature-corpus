      "position_within_division": 8
    },
    {
      "poem_number": 39,
      "poem_number_as_printed": 39,
      "source_order": 39,
      "lines": [
        "மடவைகாண் நன்நெஞ்சே மாண்பொருள் மாட்டோ டப்",
        "புடைபெயர் போழ்தத்து மாற்றாள் - படர்கூர்ந்து",
        "விம்மி யுயிர்க்கும் விளங்கிழையாள் ஆற்றுமோ",
        "நம்மில் பிரிந்த இடத்து."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 9
    },
    {
      "poem_number": 40,
      "poem_number_as_printed": 40,
      "source_order": 40,
      "lines": [
        "இன்(று)அல்கல் ஈர்ம்புடையுள் ஈர்ங்கோதை தோள்துணையா",
        "நன்கு வதிந்தனை நன்னெஞ்சே! - நாளைநாம்",
        "குன்றதர் அத்தம் இறந்து தமியமாய்",
        "என்கொலே சேக்கும் இடம்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "பாலை",
      "thinai_as_printed": "4.  பாலை",
      "division_sequence": 4,
      "position_within_division": 10
