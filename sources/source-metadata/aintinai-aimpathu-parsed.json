    {
      "poem_number": 41,
      "poem_number_as_printed": 41,
      "source_order": 41,
      "lines": [
        "தெண்கடற் சேர்ப்பன் பிரியப் புலம்(பு) அடைந்(து)",
        "ஒள்தடங்கண் துஞ்சற்க ஒள்ளிழாய் - நண்படைந்த",
        "சேவலும் தன்அருகில் சேக்குமால் என்கொலோ",
        "பூந்தலை அன்றில் புலம்பு."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "நெய்தல்",
      "thinai_as_printed": "5.  நெய்தல்",
      "division_sequence": 5,
      "position_within_division": 1
    },
    {
      "poem_number": 42,
      "poem_number_as_printed": 42,
      "source_order": 42,
      "lines": [
        "கொடுந்தாள் அலவ! குறையாம் இரப்பேம்",
        "ஒடுங்கா ஒலிகடல் சேர்ப்பன் - நெடுந்தேர்",
        "கடந்த வழியைஎம் கண்ணாரக் காண",
        "நடந்து சிதையாதி நீ."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "நெய்தல்",
      "thinai_as_printed": "5.  நெய்தல்",
      "division_sequence": 5,
      "position_within_division": 2
    },
    {
      "poem_number": 43,
      "poem_number_as_printed": 43,
      "source_order": 43,
      "lines": [
        "பொரிப்புறப் பல்லிச் சினையீன்ற புன்னை",
        "வரிப்புற வார்மணல்மேல் ஏறித் - தெரிப்புறத்",
        "தாழ்கடற் தண்சேர்ப்பன் தார்அகலம் நல்குமேல்",
        "ஆழியால் காணாமோ யாம்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "நெய்தல்",
      "thinai_as_printed": "5.  நெய்தல்",
      "division_sequence": 5,
      "position_within_division": 3
    },
    {
      "poem_number": 44,
      "poem_number_as_printed": 44,
      "source_order": 44,
      "lines": [
        "கொண்கன் பிரிந்த குளிர்பூம் பொழில்நோக்கி",
        "உண்கண் சிவப்ப அழுதேன் ஒளிமுகம்",
        "கண்டன்னை எவ்வம்யா தென்னக் கடல்வந்தென்",
        "வண்டல் சிதைத்ததென் றேன்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "thinai": "நெய்தல்",
      "thinai_as_printed": "5.  நெய்தல்",
      "division_sequence": 5,
      "position_within_division": 4
    },
    {
      "poem_number": 45,
      "poem_number_as_printed": 45,
      "source_order": 45,
      "lines": [
        "ஈர்ந்தண் பொழிலுள் இருங்கழித் தண்சேர்ப்பன்",
        "சேர்ந்தென் செறிவளைத்தோள் பற்றித் தெளித்தமை",
        "மாந்தளிர் மேனியாய் ! மன்ற விடுவனவோ",
        "பூந்தண் பொழிலுள் குருகு."
