  "title_tamil_as_printed": "விளம்பிநாகனாரின் நான்மணிக்கடிகை",
  "poems": [
    {
      "poem_number": 1,
      "poem_number_as_printed": 1,
      "source_order": 1,
      "lines": [
        "மதிமன்னு மாயவன் வாள்முகம் ஒக்கும்",
        "கதிர்சேர்ந்த ஞாயிறு சக்கரம் ஒக்கும்",
        "முதுநீர்ப் பழனத்துத் தாமரைத் தாளின்",
        "எதிர்மலர் மற்றவன் கண்ஒக்கும் பூவைப்",
        "புதுமலர் ஒக்கும் நிறம்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "section_as_printed": "கடவுள் வாழ்த்து",
      "section_sequence": 1
