      "source_note_lines": [],
      "status": "source-transcribed",
      "section_as_printed": "நூல்",
      "section_sequence": 2
    },
    {
      "poem_number": 6,
      "poem_number_as_printed": 6,
      "source_order": 6,
      "lines": [
        "கள்ளி வயிற்றின் அகில்பிறக்கும் மான்வயிற்றின்",
        "ஒள்ளரி தாரம் பிறக்கும் பெருங்கடலுள்",
        "பல்விலைய முத்தம் பிறக்கும் அறிவார்யார்",
        "நல்லாள் பிறக்குங் குடி."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "section_as_printed": "நூல்",
      "section_sequence": 2
    },
    {
