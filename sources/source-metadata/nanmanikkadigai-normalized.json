        "அருளிற் பிறக்கும் அறநெறி எல்லாம்",
        "பொருளிற் பிறந்து விடும்."
      ],
      "source_note_lines": [],
      "status": "source-transcribed",
      "section_as_printed": "நூல்",
      "section_sequence": 2
    },
    {
