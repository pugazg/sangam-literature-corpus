      "internal_structure": [
        {
          "sequence": 1,
          "heading_as_printed": "இருந்தையூர் அமர்ந்த இறைவனது அடி பரவுதல்",
          "before_body_line": 1,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 2,
          "heading_as_printed": "இருந்தையூ¡¢ன் சிறப்புகள்",
          "before_body_line": 7,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 3,
          "heading_as_printed": "மலை, குளம், வயல், ஆகியவற்றின் வளம்",
          "before_body_line": 7,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 4,
          "heading_as_printed": "அந்தணர் இருக்கை",
          "before_body_line": 18,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 5,
          "heading_as_printed": "வணிகரும் உழவர்களும் வாழும் தெருக்கள்",
          "before_body_line": 22,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 6,
          "heading_as_printed": "ஆதிசேடனது திருக்கோயிலில் மைந்தரும் மகளிரும் வழிபடுதல்",
