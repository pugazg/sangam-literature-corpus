    {
      "canonical_sequence": 20,
      "poem_number_as_printed": 20,
      "printed_heading": "20.  வையை",
      "record_type": "numbered_poem",
      "source_division": "பரிபாடல்",
      "internal_structure": [
        {
          "sequence": 1,
          "heading_as_printed": "புதுப் புனலையும் பல வகை மணங்களையும் உடன்கொண்டு வையை வருதல்",
          "before_body_line": 1,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 2,
          "heading_as_printed": "புதுப் புனலாட வைகறையில் மைந்தரும் மகளிரும் சென்ற வசை",
          "before_body_line": 12,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 3,
          "heading_as_printed": "தலைமகனது காதற்பரத்தையைத் தோழியர் கண்ட காலத்து நேர்ந்த நிகழ்ச்சி",
          "before_body_line": 27,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 4,
          "heading_as_printed": "தலைமகனது முகமாற்றமும், கூட்டத்துள் பரத்தை மறைதாம்",
          "before_body_line": 36,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 5,
          "heading_as_printed": "தன்னைத் தொடர்ந்த ஆயத்தாரோடு பரத்தை உரைத்தல்",
          "before_body_line": 40,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 6,
          "heading_as_printed": "தலைமகளின் திகைப்பு",
          "before_body_line": 46,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 7,
          "heading_as_printed": "ஆயத்தார் பரத்தையை நோக்கி வைது உரைத்தல்",
          "before_body_line": 48,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 8,
          "heading_as_printed": "பரத்தை ஏசுதலைக் கண்ட முதுமகளிர் கூற்று",
          "before_body_line": 66,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 9,
          "heading_as_printed": "பரத்தையின் பதில் உரை",
          "before_body_line": 71,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 10,
          "heading_as_printed": "தலைவி கூற்று",
          "before_body_line": 74,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 11,
          "heading_as_printed": "பரத்தையின் மறுமொழி",
          "before_body_line": 79,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 12,
          "heading_as_printed": "கண்டார் சிலருடைய கூற்று",
          "before_body_line": 84,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 13,
          "heading_as_printed": "தலைமகளுக்கு முனிவி நீங்க உரைத்தல்",
          "before_body_line": 87,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 14,
          "heading_as_printed": "கருங்கை வழியே பாயும் காட்சி",
          "before_body_line": 97,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 15,
          "heading_as_printed": "பிரிந்தாரைக் கூட்டுவித்தல் வையைக்கு இயல்பு",
          "before_body_line": 110,
          "provenance": "printed by selected canonical source"
        }
      ]
