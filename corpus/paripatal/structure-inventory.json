      "source_division": "பரிபாடல்",
      "internal_structure": [
        {
          "sequence": 1,
          "heading_as_printed": "கடவுள் வாழ்த்து",
          "before_body_line": 1,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 2,
          "heading_as_printed": "பரங்குன்றத்துப் பெருமானைப் பரவுதல்",
          "before_body_line": 1,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 3,
          "heading_as_printed": "பரங்கின்றின்மேல் ஓவியத்தின் அழகு போன்ற காட்சிகள்",
          "before_body_line": 18,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 4,
          "heading_as_printed": "குன்றத்தில் வேறுபட்ட பல ஒலிகள் ஒருங்கு இசைத்தல்",
          "before_body_line": 30,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 5,
          "heading_as_printed": "சுனை நீரில் பாய்ந்து ஆடிய காதலர்",
          "before_body_line": 39,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 6,
          "heading_as_printed": "குன்றத்தில் பலவகை மணத்துடன் வரும் காற்றுக்கள்",
          "before_body_line": 46,
          "provenance": "printed by selected canonical source"
        },
        {
          "sequence": 7,
          "heading_as_printed": "சீர்க்கு இசைய ஆடுபவளது மேனியழகும் கண்ணழகும்",
