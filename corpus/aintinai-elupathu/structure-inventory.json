{
  "prefatory_text": {
    "heading_as_printed": "கடவுள் வாழ்த்து",
    "lines": [
      "எண்ணும் பொருளினிதே எல்லாம் முடித்தெமக்கு",
      "நண்ணுங் கலையனைத்தும் நல்குமால் - கண்ணுதலின்",
      "முண்டத்தான் அண்டத்தான் மூலத்தான் நலஞ்சேர்",
      "கண்டத்தான் ஈன்ற களிறு."
    ],
