{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research/schemas/concept-definition-r15.schema.json",
  "title": "Classical Tamil R1.5 concept definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept_id",
    "dimension",
    "label_ta",
    "label_en",
    "parent_concept_id",
    "status",
    "description"
  ],
  "properties": {
    "concept_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "dimension": {"type": "string", "minLength": 1},
    "label_ta": {"type": "string", "minLength": 1},
    "label_en": {"type": "string", "minLength": 1},
    "parent_concept_id": {"type": ["string", "null"]},
    "status": {"enum": ["foundation", "pilot", "active", "deprecated"]},
    "description": {"type": "string", "minLength": 1}
  }
}
