{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-event-r1.schema.json",
  "title": "Classical Tamil Research R1 review event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_event_id",
    "event_version",
    "sequence",
    "work_id",
    "record_id",
    "assertion_id",
    "assertion_type",
    "printed_form",
    "evidence_span",
    "source_field",
    "source_location",
    "previous_status",
    "new_status",
    "decision",
    "reviewer",
    "decision_rationale",
    "supporting_assertion_ids",
    "ambiguity_note",
    "verification_scope",
    "reviewed_at",
    "previous_event_hash",
    "event_hash",
    "notes"
  ],
  "properties": {
    "review_event_id": {"type": "string", "pattern": "^review\\.r1\\.[0-9a-f]{24}$"},
    "event_version": {"const": "0.2.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "work_id": {"const": "purananuru"},
    "record_id": {"type": "string", "pattern": "^[0-9]{3}$"},
    "assertion_id": {"type": "string", "pattern": "^asrt\\.[0-9a-f]{24}$"},
    "assertion_type": {"type": "string", "minLength": 1},
    "printed_form": {"type": "string", "minLength": 1},
    "evidence_span": {"type": ["object", "null"]},
    "source_field": {"type": "string", "minLength": 1},
    "source_location": {"type": "string", "minLength": 1},
    "previous_status": {"type": "string", "minLength": 1},
    "new_status": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewer_type"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewer_type": {"enum": ["human_editor", "assistant_assisted", "automated_system"]}
      }
    },
    "decision_rationale": {"type": "string", "minLength": 1},
    "supporting_assertion_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^asrt\\.[0-9a-f]{24}$"}},
    "ambiguity_note": {"type": ["string", "null"]},
    "verification_scope": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "previous_event_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notes": {"type": ["string", "null"]}
  }
}
