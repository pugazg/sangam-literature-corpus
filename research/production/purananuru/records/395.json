ertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Source-explicit evidence retained without external expansion."},{"observation_id":"obs.prod.r15.9a04e0fd94d3d9629e2ca8af","dimension":"people_social_roles","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":1,"start_character":0,"end_line":21,"end_character":36},"source_text":"மென் புலத்து வயல் உழவர்\nவன் புலத்துப் பகடு விட்டுக்\nகுறு முயலின் குழைச் சூட்டொடு\nநெடு வாளைப் பல் உவியல்\nபழஞ் சோற்றுப் புக வருந்திப்,\nபுதல் தளவின் பூச் சூடி,\nஅரில் பறையாற் புள்ளோப்பி,\nஅவிழ் நெல்லின் அரியலா ருந்து;\nமனைக் கோழிப் பைம்பயி ரின்னே,\nகானக் கோழிக் கவர் குரலொடு,\nநீர்க் கோழிக் கூப்பெயர்க் குந்து;\nவே யன்ன மென் தோளால்,\nமயில் அன்ன மென் சாயலார்,\nகிளிகடி யின்னே;\nஅகல் அள்ளற் புள்இரீஇ யுந்து;\nஆங்கப் , பலநல்ல புலன் அணியும்\nசீர்சான்ற விழுச் சிறப்பின்,\nசிறுகண் யானைப் பெறலருந் தித்தன்\nசெல்லா நல்லிசை உறந்தைக் குணாது,\nநெடுங்கை வேண்மான் அருங்கடிப் பிடவூர்\nஅறப்பெயர்ச் சாத்தன் கிளையேம், பெரும!"},{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":24,"start_character":0,"end_line":32,"end_character":29},"source_text":"தன்கடைத் தோன்றி, என் உறவு இசைத்தலின்,\nதீங்குரல் . . கின் அரிக்குரல் தடாரியடு,\nஆங்கு நின்ற எற் கண்டு,\nசிறிதும் நில்லான், பெரிதுங் கூறான்,\nஅருங்கலம் வரவே அருளினன் வேண்டி,\nஐயென உரைத்தன்றி நல்கித், தன்மனைப்\nபொன்போல் மடந்தையைக் காட்டி,’இவனை\nஎன்போல் போற்று’ என் றோனே; அதற்கொண்டு,\nஅவன்மறவ லேனே, பிறர்உள்ள லேனே;"}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_stat