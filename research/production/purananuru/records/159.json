னற்கு இழுமெனக்\nகருவி வானம் தலைஇ யாங்கும்,\nஈத்த நின்புகழ் ஏத்தித், தொக்க என்,"}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Rain-cloud imagery is explicit weather evidence."},{"observation_id":"obs.prod.r15.79dcdd660dd80f0132930aae","dimension":"flora","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":9,"start_character":0,"end_line":12,"end_character":34},"source_text":"குப்பைக் கீரைக் கொய்கண் அகைத்த\nமுற்றா இளந்தளிர் கொய்துகொண்டு, உப்பின்று,\nநீர்உலை யாக ஏற்றி, மோரின்று,\nஅவிழ்பதம் மறந்து, பாசடகு மிசைந்து,"},{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":16,"start_character":0,"end_line":18,"end_character":27},"source_text":"கரிபுனம் மயக்கிய அகன்கண் கொல்லை.\nஐவனம் வித்தி, மையுறக் கவினி,\nஈனல் செல்லா ஏனற்கு இழுமெனக்"}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Leafy greens and cultivated grains/crops are retained as exact source flora/subsistence plants."},{"observation_id":"obs.prod.r15.2e9575d790507b9cff09a8c0","dimension":"fauna","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":22,"start_character":0,"end_line":22,"end_character":44},"source_text":"உயர்ந்து ஏந்து மருப்பின் கொல்களிறு பெறினும்,"}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"`கொல்களிறு` is retained as source fauna/gift animal."},{"observation_id":"obs.prod.r15.8ce0fbe4e7e350bd5f3f3c12","dimension":"people_social_roles","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":1,"start_character":0,"end_line":15,"end_character":42},"source_text":"`வாழும் நாளடு யாண்டுபல உண்மையின்,\nதீர்தல்செல் லாது, என் உயிர்` எனப் பலபுலந்து,\nகோல்கால் ஆகக் குறும்பல ஒதுங்கி,\nநூல்விரித் தன்ன கதுப்பினள், கண் துயின்று,\nமுன்றிற் போகா முதுர்வினள் யாயும்;\nபசந்த மேனியடு படர்அட வருந்தி,\nமருங்கில் கொண்ட பல்குறு மாக்கள்\nபிசைந்துதின வாடிய முலையள், பெரிது அழிந்து,\nகுப்பைக் கீரைக் கொய்கண் அகைத்த\nமுற்றா இளந்தளிர் கொய்துகொண்டு, உப்பின்று,\nநீர்உலை யாக ஏற்றி, மோரின்று,\nஅவிழ்பதம் மறந்து, பாசடகு மிசைந்து,\nமாசொடு குறைந்த உடுக்கையள், அறம் பழியாத்,\nதுவ்வாள் ஆகிய என்வெய் யோளும்;\nஎன்றாங்கு, இருவர் நெஞ்சமும் உவப்பக் கானவர்"},{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":20,"start_character":0,"end_line":28,"end_character":33},"source_text":"ஈத்த நின்புகழ் ஏத்தித், தொக்க என்,\nபசிதினத் திரங்கிய, ஒக்கலும் உவப்ப-\nஉயர்ந்து ஏந்து மருப்பின் கொல்களிறு பெறினும்,\nதவிர்ந்துவிடு பரிசில் கொள்ளலென்; உவந்து, நீ\nஇன்புற விடுதி யாயின், சிறிது\nகுன்றியும் கொள்வல், கூர்வேற் குமண!\nஅதற்பட அருளல் வேண்டுவல்-விறற்புகழ்\nவசையில் விழுத்திணைப் பிறந்த\nஇசைமேந் தோன்றல்! நிற் பாடிய யானே."}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Elderly mother, woman, children, forest people, household/group, patron and poet are retained as source roles."},{"observation_id":"obs.prod.r15.a95b46532ca6cb8330d6d58b","dimension":"relationships","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":1,"start_character":0,"end_line":28,"end_character":33},"source_text":"`வாழும் நாளடு யாண்டுபல உண்மையின்,\nதீர்தல்செல் லாது, என் உயிர்` எனப் பலபுலந்து,\nகோல்கால் ஆகக் குறும்பல ஒதுங்கி,\nநூல்விரித் தன்ன கதுப்பினள், கண் துயின்று,\nமுன்றிற் போகா முதுர்வினள் யாயும்;\nபசந்த மேனியடு படர்அட வருந்தி,\nமருங்கில் கொண்ட பல்குறு மாக்கள்\nபிசைந்துதின வாடிய முலையள், பெரிது அழிந்து,\nகுப்பைக் கீரைக் கொய்கண் அகைத்த\nமுற்றா இளந்தளிர் கொய்துகொண்டு, உப்பின்று,\nநீர்உலை யாக ஏற்றி, மோரின்று,\nஅவிழ்பதம் மறந்து, பாசடகு மிசைந்து,\nமாசொடு குறைந்த உடுக்கையள், அறம் பழியாத்,\nதுவ்வாள் ஆகிய என்வெய் யோளும்;\nஎன்றாங்கு, இருவர் நெஞ்சமும் உவப்பக் கானவர்\nகரிபுனம் மயக்கிய அகன்கண் கொல்லை.\nஐவனம் வித்தி, மையுறக் கவினி,\nஈனல் செல்லா ஏனற்கு இழுமெனக்\nகருவி வானம் தலைஇ யாங்கும்,\nஈத்த நின்புகழ் ஏத்தித், தொக்க என்,\nபசிதினத் திரங்கிய, ஒக்கலும் உவப்ப-\nஉயர்ந்து ஏந்து மருப்பின் கொல்களிறு பெறினும்,\nதவிர்ந்துவிடு பரிசில் கொள்ளலென்; உவந்து, நீ\nஇன்புற விடுதி யாயின், சிறிது\nகுன்றியும் கொள்வல், கூர்வேற் குமண!\nஅதற்பட அருளல் வேண்டுவல்-விறற்புகழ்\nவசையில் விழுத்திணைப் பிறந்த\nஇசைமேந் தோன்றல்! நிற் பாடிய யானே."}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Mother/child, household, speaker/patron and recipient relationships are explicit."},{"observation_id":"obs.prod.r15.5e2aae83ccfe1c2561182121","dimension":"emotion_lived_experience","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_bod