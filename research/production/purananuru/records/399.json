:33,"start_character":0,"end_line":34,"end_character":34},"source_text":"இழுமென இழிதரும் அருவி,\nவான்தோய் உயர்சிமைத் தோன்றிக் கோவே."}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Source-explicit evidence retained without external expansion."},{"observation_id":"obs.prod.r15.1b997f5ba02ceff50280da3a","dimension":"flora","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":4,"start_character":0,"end_line":4,"end_character":35},"source_text":"ஓங்குசினை மாவின் தீங்கனி நறும்புளி,"},{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":6,"start_character":0,"end_line":7,"end_character":33},"source_text":"செறுவின் வள்ளை, சிறுகொடிப் பாகல்,\nபாதிரி யூழ்முகை அவிழ்விடுத் தன்ன,"}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Source-explicit evidence retained without external expansion."},{"observation_id":"obs.prod.r15.aec54646f36591278a49a496","dimension":"fauna","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":5,"start_character":0,"end_line":5,"end_character":39},"source_text":"மோட்டிவரு வராஅல் கோட்டுமீன் கொழுங்குறை,"},{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":27,"start_character":0,"end_line":32,"end_character":28},"source_text":"‘கடுந்தேர் அள்ளற்கு அசாவா நோன்சுவல்\nபகடே அத்தை யான் வேண்டிவந் தது’ என,\nஒன்றியான் பெட்டா அளவை, அன்றே\nஆன்று விட்டனன் அத்தை; விசும்பின்\nமீன்பூத் தன்ன உருவப் பன்னிரை\nஊர்தியடு நல்கி யோனே; சீர்கொள"}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Source-explicit evidence retained without external expansion."},{"observation_id":"obs.prod.r15.8fb460b37f463b16dd6dc3d4","dimension":"people_social_roles","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":1,"start_character":0,"end_line":18,"end_character":32},"source_text":"அடுமகள் முகந்த அளவா வெண்ணெல்\nதொடிமாண் உலக்கைப் பருஉக்குற் றரிசி\nகாடி வெள்ளுலைக் கொளீஇ நீழல்\nஓங்குசினை மாவின் தீங்கனி நறும்புளி,\nமோட்டிவரு வராஅல் கோட்டுமீன் கொழுங்குறை,\nசெறுவின் வள்ளை, சிறுகொடிப் பாகல்,\nபாதிரி யூழ்முகை அவிழ்விடுத் தன்ன,\nமெய்களைந்து, இன்னொடு விரைஇ. . .\nமூழ்ப்பப் பெய்த முழுஅவிழ்ப் புழுக்கல்,\nஅழிகளிற் படுநர் களியட வைகின்,\nபழஞ்சோறு அயிலும் முழங்குநீர்ப் படப்பைக்\nகாவிரிக் கிழவன், மாயா நல்லிசைக்\nகிள்ளி வளவன் உள்ளி, அவன்படர்தும்;\nசெல்லேன் செல்லேன், பிறர்முகம் நோக்கேன்;\nநெடுங்கழைத் தூண்டில் விடுமீன் நொடுத்துக்,\nகிணைமகள் அட்ட பாவற் புளிங்கூழ்\nபொழுதுமறுத் துண்ணும் உண்டியேன், அழிவுகொண்டு,\nஒருசிறை இருந்தேன்; என்னே! இனியே,"},{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":19,"start_character":0,"end_line":34,"end_character":34},"source_text":"‘அறவர் அறவன், மறவர் மறவன்,\nமள்ளர் மள்ளன்,தொல்லோர் மருகன்,\nஇசையிற் கொண்டான், நசையமுது உண்க’ என,\nமீப்படர்ந்து இறந்து, வன்கோல் மண்ணி,\nவள்பரிந்து கிடந்தஎன் தெண்கண் மாக்கிணை\nவிசிப்புறுத்து அமைந்த புதுக்காழ்ப் போர்வை,\nஅலகின் மாலை ஆர்ப்ப வட்டித்துக்,\nகடியும் உணவென்ன கடவுட்கும் தொடேன்;\n‘கடுந்தேர் அள்ளற்கு அசாவா நோன்சுவல்\nபகடே அத்தை யான் வேண்டிவந் தது’ என,\nஒன்றியான் பெட்டா அளவை, அன்றே\nஆன்று விட்டனன் அத்தை; விசும்பின்\nமீன்பூத் தன்ன உருவப் பன்னிரை\nஊர்தியடு நல்கி யோனே; சீர்கொள\nஇழுமென இழிதரும் அருவி,\nவான்தோய் உயர்சிமைத் தோன்றிக் கோவே."}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","review_status":"reviewed","reviewer_type":"assistant_assisted","historical_identity_status":"not_applicable","note":"Exact `அறவர்`, `மறவர்`, `மள்ளர்`, `தொல்லோர்` and other source role terms are retained without later hierarchy/community substitution."},{"observation_id":"obs.prod.r15.0b0b529c396a8a3ba508c8bd","dimension":"relationships","concept_id":null,"evidence_class":"SOURCE_EXPLICIT","classification_basis":"direct_record_review","evidence_refs":[{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":12,"start_character":0,"end_line":21,"end_character":36},"source_text":"காவிரிக் கிழவன், மாயா நல்லிசைக்\nகிள்ளி வளவன் உள்ளி, அவன்படர்தும்;\nசெல்லேன் செல்லேன், பிறர்முகம் நோக்கேன்;\nநெடுங்கழைத் தூண்டில் விடுமீன் நொடுத்துக்,\nகிணைமகள் அட்ட பாவற் புளிங்கூழ்\nபொழுதுமறுத் துண்ணும் உண்டியேன், அழிவுகொண்டு,\nஒருசிறை இருந்தேன்; என்னே! இனியே,\n‘அறவர் அறவன், மறவர் மறவன்,\nமள்ளர் மள்ளன்,தொல்லோர் மருகன்,\nஇசையிற் கொண்டான், நசையமுது உண்க’ என,"},{"source_field":"canonical_body","source_location":"markdown:canonical-body","evidence_span":{"start_line":26,"start_character":0,"end_line":34,"end_character":34},"source_text":"கடியும் உணவென்ன கடவுட்கும் தொடேன்;\n‘கடுந்தேர் அள்ளற்கு அசாவா நோன்சுவல்\nபகடே அத்தை யான் வேண்டிவந் தது’ என,\nஒன்றியான் பெட்டா அளவை, அன்றே\nஆன்று விட்டனன் அத்தை; விசும்பின்\nமீன்பூத் தன்ன உருவப் பன்னிரை\nஊர்தியடு நல்கி யோனே; சீர்கொள\nஇழுமென இழிதரும் அருவி,\nவான்தோய் உயர்சிமைத் தோன்றிக் கோவே."}],"supporting_assertion_ids":[],"assertion_provenance_status":"direct_r15_source_review_no_prior_assertion","confidence":"high","rev